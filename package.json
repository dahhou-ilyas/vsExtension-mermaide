{
  "name": "flowchartgenerator",
  "displayName": "Flowchart Generator",
  "description": "Turn JavaScript and TypeScript into interactive flowcharts, edit the chart, and get your code back with formatting and comments intact. Private: runs fully offline.",
  "version": "3.2.0",
  "publisher": "GeneratedFlowChart",
  "author": {
    "name": "Ilyas Dahhou"
  },
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://github.com/dahhou-ilyas/vsExtension-mermaide#readme",
  "bugs": {
    "url": "https://github.com/dahhou-ilyas/vsExtension-mermaide/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dahhou-ilyas/vsExtension-mermaide"
  },
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "flowchart",
    "control flow",
    "diagram",
    "visualization",
    "javascript",
    "typescript",
    "react",
    "complexity",
    "code generation",
    "flowchart to code",
    "visual programming",
    "mermaid export",
    "cfg",
    "graph to code",
    "code review",
    "code visualization",
    "node",
    "jsx",
    "tsx"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onWebviewPanel:flowchartGenerator.panel"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "flowchartGenerator.generate",
        "title": "Generate Flowchart",
        "category": "Flowchart",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "flowchartGenerator.generateFile",
        "title": "Generate Flowchart for Entire File",
        "category": "Flowchart"
      },
      {
        "command": "flowchartGenerator.showPanel",
        "title": "Show Flowchart Panel",
        "category": "Flowchart"
      },
      {
        "command": "flowchartGenerator.clearHistory",
        "title": "Clear Flowchart History",
        "category": "Flowchart"
      },
      {
        "command": "flowchartGenerator.newFlowchart",
        "title": "New Flowchart (Design → Code)",
        "category": "Flowchart",
        "icon": "$(add)"
      },
      {
        "command": "flowchartGenerator.codeFromMermaid",
        "title": "Generate Code from Mermaid Flowchart",
        "category": "Flowchart"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "flowchartGenerator.generate",
          "when": "editorLangId =~ /^(javascript|javascriptreact|typescript|typescriptreact)$/",
          "group": "navigation@90"
        },
        {
          "command": "flowchartGenerator.codeFromMermaid",
          "when": "editorLangId =~ /^(markdown|mermaid)$/ || resourceExtname =~ /^\\.(mmd|mermaid)$/",
          "group": "navigation@91"
        }
      ],
      "editor/title": [
        {
          "command": "flowchartGenerator.generate",
          "when": "editorLangId =~ /^(javascript|javascriptreact|typescript|typescriptreact)$/ && config.flowchartGenerator.showEditorTitleButton",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "flowchartGenerator.generate",
          "when": "editorLangId =~ /^(javascript|javascriptreact|typescript|typescriptreact)$/"
        },
        {
          "command": "flowchartGenerator.generateFile",
          "when": "editorLangId =~ /^(javascript|javascriptreact|typescript|typescriptreact)$/"
        },
        {
          "command": "flowchartGenerator.codeFromMermaid",
          "when": "editorIsOpen"
        }
      ]
    },
    "keybindings": [
      {
        "command": "flowchartGenerator.generate",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "editorTextFocus && editorLangId =~ /^(javascript|javascriptreact|typescript|typescriptreact)$/"
      }
    ],
    "configuration": {
      "title": "Flowchart Generator",
      "properties": {
        "flowchartGenerator.direction": {
          "type": "string",
          "enum": [
            "TD",
            "LR"
          ],
          "enumDescriptions": [
            "Top to bottom",
            "Left to right"
          ],
          "default": "TD",
          "description": "Layout direction of generated flowcharts."
        },
        "flowchartGenerator.style": {
          "type": "string",
          "enum": [
            "classic",
            "cyberpunk"
          ],
          "enumDescriptions": [
            "Classic flowchart symbols (ISO 5807), smooth curved arrows, colours that follow the VS Code light / dark theme",
            "Neon panels, circuit-board traces and animated flow on a dark grid"
          ],
          "default": "classic",
          "description": "Visual style of the flowchart renderer."
        },
        "flowchartGenerator.animations": {
          "type": "boolean",
          "default": true,
          "description": "Animate node appearance, layout changes while editing and (cyberpunk style) the flow along edges. Also disabled when the OS asks for reduced motion."
        },
        "flowchartGenerator.maxLabelLength": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 300,
          "description": "Maximum characters per label when `flowchartGenerator.labels.mode` is `truncate`."
        },
        "flowchartGenerator.labels.mode": {
          "type": "string",
          "enum": [
            "wrap",
            "truncate"
          ],
          "enumDescriptions": [
            "Wrap long code on several lines and fold nested brackets ({…}) when it is very long",
            "Cut labels after `flowchartGenerator.maxLabelLength` characters"
          ],
          "default": "wrap",
          "description": "How long code is displayed in nodes. The full code is always available in the node tooltip."
        },
        "flowchartGenerator.labels.lineWidth": {
          "type": "number",
          "default": 40,
          "minimum": 15,
          "maximum": 120,
          "description": "Characters per line in node labels (wrap mode)."
        },
        "flowchartGenerator.labels.maxLines": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 30,
          "description": "Maximum lines per statement in node labels (wrap mode)."
        },
        "flowchartGenerator.exceptions": {
          "type": "string",
          "enum": [
            "detailed",
            "summary"
          ],
          "enumDescriptions": [
            "An edge from every statement of a try block that may throw (calls, new, await, throw) to its catch or finally",
            "A single edge from try to catch"
          ],
          "default": "detailed",
          "description": "How exceptional control flow is drawn."
        },
        "flowchartGenerator.callbacks.expand": {
          "type": "boolean",
          "default": true,
          "description": "Draw inline callbacks (forEach, map, then, event handlers, IIFEs…) as their own flows, linked to the statement that contains them."
        },
        "flowchartGenerator.callbacks.maxDepth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "How many levels of nested callbacks are expanded."
        },
        "flowchartGenerator.mergeSequentialStatements": {
          "type": "boolean",
          "default": true,
          "description": "Group consecutive simple statements into a single block to keep diagrams compact."
        },
        "flowchartGenerator.maxStatementsPerBlock": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum number of statements grouped in one block when merging is enabled."
        },
        "flowchartGenerator.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a \"Flowchart\" CodeLens above every function."
        },
        "flowchartGenerator.showEditorTitleButton": {
          "type": "boolean",
          "default": true,
          "description": "Show the Generate Flowchart button in the editor title bar."
        },
        "flowchartGenerator.openBeside": {
          "type": "boolean",
          "default": true,
          "description": "Open the flowchart panel beside the active editor instead of on top of it."
        },
        "flowchartGenerator.historyLimit": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 200,
          "description": "Maximum number of flowcharts kept per workspace."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "webpack --mode production",
    "lint": "eslint .",
    "test:unit": "mocha \"test/unit/**/*.test.js\"",
    "pretest": "npm run compile",
    "test": "npm run test:unit && vscode-test",
    "vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/parser": "^7.29.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.0",
    "@eslint/js": "^9.30.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.30.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "mocha": "^11.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.100.0",
    "webpack-cli": "^6.0.1"
  }
}
